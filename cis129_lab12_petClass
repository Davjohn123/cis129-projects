def main ():
    inputName = ""
    inputType = ""
    inputAge = 0
    Animal = Pet(inputName, inputType, inputAge)
    
    inputName = str(input("Enter a pet name:\n"))
    Animal.setName(inputName)
                    
    inputType = str(input("Enter a pet type:\n"))
    Animal.setType(inputType)

    inputAge = int(input("Enter a pet age:\n"))
    Animal.setAge(inputAge)

    print ("The pet name is", Animal.getName())
    print ("The pet type is", Animal.getType())
    print ("The pet age is", Animal.getAge())

class Pet():
    def __init__(self, n, t, a):
        self.name = n
        self.type = t
        self.age = a
    def setName (self, n):
        self.name = n
        
    def setType (self, t):
        self.type = t
        
    def setAge (self, a):
        self.age = a
        
    def getName(self):
        return self.name
    def getType(self):
        return self.type
    def getAge(self):
        return self.age

main()
